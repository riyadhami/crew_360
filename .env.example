# ── Azure OpenAI ────────────────────────────────────────────────────────────
LLM_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
LLM_MODEL=gpt-5.4
API_VERSION=2024-02-15-preview


EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_VERSION=2023-05-15
EMBEDDING_BASE_URL=https://xyz.openai.azure.com
EMBEDDING_ENDPOINT="${EMBEDDING_BASE_URL}/openai/deployments/${EMBEDDING_MODEL}/embeddings?api-version=${EMBEDDING_API_VERSION}"
EMBEDDING_API_KEY=<your-key>

# ── Azure Cosmos DB (Gremlin API) ───────────────────────────────────────────
# COSMOS_DB_DATABASE must already exist on the account (this project's key sees
# BluChipKG). COSMOS_DB_GRAPH is a NEW graph container — partition key /source —
# so donor graphs are never written.
COSMOS_DB_ENDPOINT=<your-account>.gremlin.cosmos.azure.com
COSMOS_DB_KEY=<your-primary-key>
COSMOS_DB_DATABASE=BluChipKG
COSMOS_DB_GRAPH=CrewPerfKG

# ── Data layer ──────────────────────────────────────────────────────────────
# snowflake (default, production warehouse) | duckdb (local synthetic dataset)
SNOWFLAKE_MODE=duckdb

# Still used in snowflake mode. ServiceNow is a file extract, not a warehouse
# schema: its tables are served from here while PEP, CLMS and CREWPORTAL come
# from Snowflake. Ingest it with `crewperf ingest-servicenow`.
DUCKDB_PATH=data/crew_perf.duckdb

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_DATABASE=

# ── Authentication ──
SNOWFLAKE_PAT=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=

# Session default only. The live data spans three schemas — PEP, CLMS,
# CREWPORTAL — and the connector resolves each table into the schema it belongs
# to, read from the TABLE_SCHEMA column of the exports in schemas/. Those exports
# are also the allow-list: no table outside them is queryable, whatever else the
# account holds. Nothing needs setting here unless your warehouse renamed the
# schemas on the way in.
SNOWFLAKE_SCHEMA=PEP
# SNOWFLAKE_SCHEMA_PEP=PEP
# SNOWFLAKE_SCHEMA_CLMS=CLMS
# SNOWFLAKE_SCHEMA_CREWPORTAL=CREWPORTAL

# Seconds. A suspended warehouse can take tens of seconds to resume.
# SNOWFLAKE_LOGIN_TIMEOUT=60
# SNOWFLAKE_QUERY_TIMEOUT=300

# ── Synthetic data generation ───────────────────────────────────────────────
SYNTH_SEED=20260731
SYNTH_CREW_COUNT=800
SYNTH_MONTHS=18
